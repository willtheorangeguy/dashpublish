# Secrets and runtime overrides for dashpublish.
# Copy to .env and fill in. Never commit real secrets.

# Embedding / LLM provider keys (only the one for your chosen backend is needed).
GEMINI_API_KEY=
DASHSCOPE_API_KEY=

# Path to the Google OAuth client secrets JSON (Desktop app credentials).
YOUTUBE_CLIENT_SECRETS=path/to/client_secrets.json

# Path to the dashpublish.toml config file (defaults to ./dashpublish.toml).
DASHPUBLISH_CONFIG=./dashpublish.toml

# Set to 1/true to enable offline fake mode (no external keys/network needed).
DASHPUBLISH_FAKE=0
